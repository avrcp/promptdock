# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=24.18.0
ARG UBUNTU_VERSION=24.04
ARG RUST_VERSION=1.98.0

FROM node:${NODE_VERSION}-bookworm-slim AS node-toolchain

FROM caddy:2.11.4-alpine AS caddy-toolchain

FROM ubuntu:${UBUNTU_VERSION}

ARG RUST_VERSION
ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    PATH=/opt/cargo/bin:/usr/local/bin:${PATH}

COPY --from=node-toolchain /usr/local/ /usr/local/
COPY --from=caddy-toolchain /usr/bin/caddy /usr/local/bin/caddy

# Release validation runs with all ambient capabilities dropped. Keep Caddy as
# an unprivileged offline config parser by removing the upstream file capability.
RUN cp --no-preserve=xattr /usr/local/bin/caddy /tmp/caddy && \
    mv /tmp/caddy /usr/local/bin/caddy && \
    chmod 0755 /usr/local/bin/caddy

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && \
    apt-get install --yes --no-install-recommends \
        build-essential ca-certificates curl git libsqlite3-dev libssl-dev \
        pkg-config python3 sqlite3 xz-utils && \
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
        https://sh.rustup.rs | \
        sh -s -- -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_VERSION}" --component clippy,rustfmt && \
    rustup target add x86_64-unknown-linux-gnu && \
    rm -f /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg && \
    corepack enable pnpm && corepack prepare pnpm@11.10.0 --activate && \
    corepack pnpm dlx playwright@1.49.1 install --with-deps chromium && \
    node --version | grep -Fx 'v24.18.0' && \
    rustc --version | grep -F 'rustc 1.98.0 '

ENV PROMPTDOCK_RELEASE_BUILDER=1
WORKDIR /workspace
ENTRYPOINT ["bash"]
