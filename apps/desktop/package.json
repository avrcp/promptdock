{
  "name": "@promptdock/desktop",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "contracts:check": "tsx scripts/check-relay-contract.ts",
    "typecheck": "vue-tsc --noEmit",
    "design:check": "node scripts/check-design-tokens.mjs",
    "dev:mock": "vite --config vite.mock.config.ts",
    "design:qa": "node scripts/dev/screenshot-views.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
