{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the bundled PromptDock main window",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-desktop-health-check",
    "allow-desktop-health-export",
    "allow-desktop-health-test-start",
    "allow-desktop-health-test-status",
    "allow-desktop-host-focus",
    "allow-desktop-notification-hold-status",
    "allow-desktop-notification-hold-set",
    "allow-desktop-notification-hold-resume",
    "allow-desktop-activity-page",
    "allow-desktop-activity-detail",
    "allow-desktop-attention-ack",
    "allow-desktop-result-mark-seen",
    "allow-desktop-status",
    "allow-desktop-hook-health",
    "allow-desktop-hook-plan",
    "allow-desktop-hook-verify",
    "allow-desktop-hook-self-test",
    "allow-desktop-delivery-metadata",
    "allow-desktop-save-policy",
    "allow-desktop-install-hook",
    "allow-desktop-uninstall-hook",
    "allow-desktop-launcher-status",
    "allow-desktop-launcher-refresh",
    "allow-desktop-launcher-save",
    "allow-desktop-launch",
    "allow-desktop-relay-status",
    "allow-desktop-relay-configure",
    "allow-desktop-relay-probe",
    "allow-desktop-relay-test",
    "allow-desktop-deliveries",
    "allow-desktop-delivery-detail",
    "allow-desktop-export-delivery",
    "allow-desktop-result-link",
    "allow-desktop-result-open",
    "allow-desktop-result-revoke",
    "allow-desktop-result-resend",
    "allow-desktop-autostart-status",
    "allow-desktop-autostart-set",
    "allow-desktop-diagnostics",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-maximized",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
